-- ResolveIQ ACAN schema (new independent module, empty cloud, no conflicts)

create table if not exists resolveiq_cases (
  id uuid primary key default gen_random_uuid(),
  case_number text unique not null,
  customer_name text not null,
  customer_email text not null,
  customer_phone text,
  order_id text not null,
  merchant text,
  category text not null,
  description text not null,
  incident_at timestamptz not null,
  location text,
  severity text not null default 'medium' check (severity in ('low','medium','high','critical')),
  status text not null default 'new' check (status in ('new','investigating','verifying','arbitrating','resolving','resolved','escalated')),
  stage text not null default 'understand' check (stage in ('understand','investigate','reconstruct','verify','arbitrate','resolve','verify_resolution','escalated')),
  confidence numeric check (confidence >= 0 and confidence <= 100),
  scenario_key text not null,
  escalated boolean not null default false,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists resolveiq_evidence (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references resolveiq_cases(id) on delete cascade,
  source text not null,
  title text not null,
  description text not null,
  event_at timestamptz,
  status text not null default 'pending' check (status in ('pending','verified','contradicted','disputed')),
  confidence numeric not null default 0 check (confidence >= 0 and confidence <= 100),
  finding text,
  detail jsonb not null default '{}'::jsonb,
  verified_at timestamptz,
  created_at timestamptz not null default now()
);

create table if not exists resolveiq_timeline_events (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references resolveiq_cases(id) on delete cascade,
  source text not null,
  title text not null,
  description text not null,
  event_at timestamptz not null,
  role text not null default 'context' check (role in ('trigger','outcome','context')),
  flagged boolean not null default false,
  sort_order int not null default 0,
  created_at timestamptz not null default now()
);

create table if not exists resolveiq_agent_findings (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references resolveiq_cases(id) on delete cascade,
  agent text not null check (agent in ('order','payment','logistics','merchant','policy','risk')),
  status text not null default 'completed' check (status in ('running','completed','failed')),
  evidence_found jsonb not null default '[]'::jsonb,
  finding text not null,
  confidence numeric not null default 0 check (confidence >= 0 and confidence <= 100),
  ran_at timestamptz not null default now(),
  created_at timestamptz not null default now(),
  unique (case_id, agent)
);

create table if not exists resolveiq_decisions (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references resolveiq_cases(id) on delete cascade,
  recommended_actions jsonb not null default '[]'::jsonb,
  reasoning text not null,
  confidence numeric not null check (confidence >= 0 and confidence <= 100),
  policy_checks jsonb not null default '[]'::jsonb,
  risk_level text not null check (risk_level in ('low','medium','high')),
  risk_detail text,
  escalation_required boolean not null default false,
  escalation_reason text,
  decision_at timestamptz not null default now(),
  created_at timestamptz not null default now()
);

create table if not exists resolveiq_actions (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references resolveiq_cases(id) on delete cascade,
  action_type text not null check (action_type in ('refund','redispatch','replacement','notify_customer','update_ticket')),
  label text not null,
  amount numeric,
  authorization_mode text not null check (authorization_mode in ('auto','manual')),
  status text not null default 'pending' check (status in ('pending','executing','completed','failed')),
  execution_detail jsonb not null default '{}'::jsonb,
  executed_at timestamptz,
  verification jsonb not null default '{}'::jsonb,
  verification_status text check (verification_status in ('pending','successful','failed')),
  verified_at timestamptz,
  created_at timestamptz not null default now()
);

create table if not exists resolveiq_audit_log (
  id uuid primary key default gen_random_uuid(),
  case_id uuid references resolveiq_cases(id) on delete cascade,
  actor text not null default 'system',
  action text not null,
  detail jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now()
);

create table if not exists resolveiq_settings (
  key text primary key,
  value jsonb not null
);

insert into resolveiq_settings (key, value) values ('confidence_threshold', '85') on conflict (key) do nothing;
insert into resolveiq_settings (key, value) values ('auto_authorization_limit', '250') on conflict (key) do nothing;

create index if not exists idx_cases_status on resolveiq_cases(status);
create index if not exists idx_cases_created on resolveiq_cases(created_at desc);
create index if not exists idx_evidence_case on resolveiq_evidence(case_id);
create index if not exists idx_timeline_case on resolveiq_timeline_events(case_id);
create index if not exists idx_findings_case on resolveiq_agent_findings(case_id);
create index if not exists idx_actions_case on resolveiq_actions(case_id);
create index if not exists idx_audit_case on resolveiq_audit_log(case_id, created_at desc);

-- RLS enabled, no anon policies: all data access flows through backend functions (service role)
alter table resolveiq_cases enable row level security;
alter table resolveiq_evidence enable row level security;
alter table resolveiq_timeline_events enable row level security;
alter table resolveiq_agent_findings enable row level security;
alter table resolveiq_decisions enable row level security;
alter table resolveiq_actions enable row level security;
alter table resolveiq_audit_log enable row level security;
alter table resolveiq_settings enable row level security;